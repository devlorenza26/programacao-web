body {
    background-color: #fefeff;
    font-family: Arial, sans-serif;
    margin: 20px;
    color: #333;
}

header {
    background-color: #d5d6e6;
    padding: 15px;
    border-radius: 5px;
    margin-bottom: 20px;
}

nav ul {
    list-style-type: none;
    padding: 0;
}

nav ul li {
    display: inline;
    margin-right: 15px;
}

nav ul li a {
    text-decoration: none;
    color: #0066cc;
    font-weight: bold;
}

table {
    width: 100%;
    border-collapse: collapse;
    background-color: #fff;
}

table, th, td {
    border: 1px solid #ccc;
}

th, td {
    padding: 8px;
    text-align: left;
}

.texto-centralizado {
    text-align: center;
}

#tabuleiro {
    background-color: #e6a3a3;
    padding: 20px;
    border: 1px dashed #970909;
    min-height: 100px;
}
